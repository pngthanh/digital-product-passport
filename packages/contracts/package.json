{
  "name": "@dpp/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Smart Contract Solidity (Hardhat 3 + OpenZeppelin) triển khai trên Monad Testnet",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "compile": "hardhat build",
    "test": "hardhat test mocha",
    "node": "hardhat node",
    "deploy:local": "hardhat run --network localhost scripts/deploy-identity.ts",
    "deploy:monad": "hardhat run --network monadTestnet scripts/deploy-identity.ts",
    "admin-role:local": "hardhat run --network localhost scripts/grant-admin-role.ts",
    "admin-role:monad": "hardhat run --network monadTestnet scripts/grant-admin-role.ts",
    "abi:export": "hardhat run scripts/export-abi.ts",
    "clean": "hardhat clean",
    "typecheck": "hardhat build --quiet && tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json test scripts ignition hardhat.config.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@dpp/shared": "workspace:*",
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@nomicfoundation/ignition-core": "^3.1.8",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "chai": "^6.3.0",
    "dotenv": "^18.0.9",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.1",
    "mocha": "^12.0.3",
    "oxlint": "^1.90.0",
    "typescript": "~6.0.3"
  }
}
