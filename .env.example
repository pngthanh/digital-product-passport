# =============================================================================
# File cấu hình duy nhất cho toàn bộ monorepo.
# Sao chép thành .env:  cp .env.example .env   (Windows: copy .env.example .env)
# KHÔNG commit file .env — nó có thể chứa khoá riêng của ví.
# =============================================================================

# ----- PostgreSQL (docker compose đọc các biến này) --------------------------
POSTGRES_USER=dpp
POSTGRES_PASSWORD=dpp_dev_password
POSTGRES_DB=dpp
# Cổng trên máy host. Dùng 5433 để không đụng PostgreSQL cài sẵn trên máy (thường giữ 5432).
POSTGRES_PORT=5433

# Chuỗi kết nối cho Prisma (API, Worker, migration)
DATABASE_URL=postgresql://dpp:dpp_dev_password@127.0.0.1:5433/dpp
# CSDL riêng cho test e2e (docker compose tự tạo dpp_test)
TEST_DATABASE_URL=postgresql://dpp:dpp_dev_password@127.0.0.1:5433/dpp_test

# ----- API và Worker (apps/api) ----------------------------------------------
NODE_ENV=development
# error | warn | log | debug | verbose
LOG_LEVEL=log
API_PORT=4000
# Origin của web, dùng cho CORS
WEB_ORIGIN=http://localhost:3000

# ----- Blockchain -------------------------------------------------------------
# 10143 = Monad Testnet, 31337 = Hardhat local (`pnpm --filter @dpp/contracts node`)
CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
# RPC dự phòng khi RPC chính lỗi; để trống nếu không dùng
RPC_FALLBACK_URL=https://rpc.ankr.com/monad_testnet
RPC_TIMEOUT_MS=5000

# ----- Đăng nhập (M2) ---------------------------------------------------------
# Khoá ký JWT phiên đăng nhập, ít nhất 32 ký tự ngẫu nhiên. Tạo: pnpm --filter @dpp/api secret:new
JWT_SECRET=
# Thời gian sống của phiên (phút). Đăng xuất thu hồi mọi phiên ngay, không cần chờ hết hạn.
SESSION_TTL_MINUTES=720
# Số lần thử đăng ký/đăng nhập tối đa mỗi phút cho một IP
AUTH_RATE_LIMIT_PER_MINUTE=10

# ----- Liên kết ví MetaMask (M2, PartyRegistry) -------------------------------
# Khoá ký giấy phép EIP-712 của backend: chỉ ký, KHÔNG gửi giao dịch, KHÔNG cần nạp MON.
# Tạo: pnpm --filter @dpp/api registrar:new   (khoá riêng, không commit)
REGISTRAR_SIGNER_PRIVATE_KEY=
# In ra sau khi deploy: pnpm --filter @dpp/contracts deploy:local | deploy:monad
PARTY_REGISTRY_ADDRESS=
# Block lúc deploy; Indexer (M3) bắt đầu quét log từ đây
PARTY_REGISTRY_DEPLOY_BLOCK=

# ----- Web (apps/web) ---------------------------------------------------------
# Trình duyệt gọi /api/v1 trên chính web; Next.js chuyển tiếp tới địa chỉ này
# (Server Component cũng gọi API qua đây). Đổi khi API chạy ở máy/cổng khác.
API_INTERNAL_URL=http://localhost:4000/api/v1
# Phải trùng CHAIN_ID ở trên: MetaMask được chuyển sang đúng mạng này
NEXT_PUBLIC_CHAIN_ID=10143

# ----- Smart Contract (packages/contracts) -----------------------------------
# Để trống thì dùng RPC công khai của Monad Testnet
MONAD_TESTNET_RPC_URL=
# Khoá riêng ví deploy (chỉ ví test!). An toàn hơn: lưu vào keystore của Hardhat:
#   pnpm --filter @dpp/contracts exec hardhat keystore set DEPLOYER_PRIVATE_KEY
DEPLOYER_PRIVATE_KEY=
# Không bắt buộc: xác minh mã nguồn trên Monadscan (Sourcify của MonadVision không cần key)
ETHERSCAN_API_KEY=
# Không bắt buộc: đường dẫn solc cục bộ khi mạng chặn binaries.soliditylang.org
SOLC_PATH=
